# Konfigurasi aplikasi Noura Payroll (TIDAK SENSITIF).
# Salin menjadi .env lalu jalankan: node scripts/build-env.mjs  -> menghasilkan js/env.js
#
# URL proyek Supabase (Project Settings › API › Project URL)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Kunci publik (anon / publishable key). AMAN untuk browser karena data dilindungi RLS.
# JANGAN PERNAH mengisi service_role / secret key di sini.
SUPABASE_ANON_KEY=
# Nama lingkungan untuk ditampilkan (development / production)
APP_ENV=production
