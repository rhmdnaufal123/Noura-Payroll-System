# Konfigurasi aplikasi Noura Payroll (TIDAK SENSITIF).
# Salin menjadi .env lalu jalankan: node scripts/build-env.mjs  -> menghasilkan js/env.js
#
# URL proyek Supabase (Project Settings › API › Project URL)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Kunci publik (Project Settings › API Keys › Publishable key, "sb_publishable_...").
# AMAN untuk browser karena data dilindungi RLS. Anon key lama (JWT) juga diterima.
SUPABASE_PUBLISHABLE_KEY=
#
# JANGAN menaruh SUPABASE_SECRET_KEY (sb_secret_...) atau service role key di file ini.
# Kunci rahasia hanya dipakai Edge Function, yang mendapatkannya otomatis dari Supabase.
#
# Nama lingkungan (development / production)
APP_ENV=production
